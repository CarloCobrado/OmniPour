<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Default Connection using LocalDB instance tested and verified on this machine -->
    <add name="OmniPourDB"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=OmniPourDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
    <add name="OmniPourDB"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=OmniPourDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="AppName" value="OmniPour Beverage POS &amp; Inventory Suite" />
    <add key="StoreName" value="OmniPour Operations Terminal" />
    <add key="StoreAddress" value="Beverage Station 1" />
    <add key="TaxRatePercent" value="0.00" />
    <add key="MaxFailedLogins" value="3" />
    <add key="LockoutMinutes" value="5" />
  </appSettings>
</configuration>
